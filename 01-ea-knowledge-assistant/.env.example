# Copy to .env (same folder) and fill in ONE provider block. .env is git-ignored — never commit it.
# Works for both local runs (read at start-up) and docker compose. Real environment variables win over .env.
# Check your setup any time with:  eaka check
# With nothing set, the assistant runs fully offline (extractive cited answers).
# Keep comments on their own lines (a comment after a value becomes part of the value).

# ---------------------------------------------------------------- choose ONE
# extractive | anthropic | azure_openai | openai
EAKA_LLM_PROVIDER=extractive

# ---------------------------------------------------------------- Anthropic (Claude)
# Key: https://platform.claude.com -> API keys
# Model: claude-sonnet-5-5 (default), claude-haiku-4-5-20251001 (cheaper, faster), claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...
# EAKA_LLM_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------- Azure OpenAI (Microsoft Foundry)
# Endpoint + key: Azure portal -> your Azure OpenAI resource -> Keys and Endpoint
# Deployment: https://ai.azure.com -> Deployments -> the NAME you gave the deployment (not the model name)
# Leave AZURE_OPENAI_API_VERSION unset to use the v1 endpoint (recommended).
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# ---------------------------------------------------------------- OpenAI
# Key: https://platform.openai.com -> API keys
# OPENAI_API_KEY=sk-...
# EAKA_LLM_MODEL=gpt-5-mini

# ---------------------------------------------------------------- optional tuning
# Answer token budget (raised automatically to leave room for model reasoning)
# EAKA_MAX_ANSWER_TOKENS=700
# Embeddings: lsa (offline) | openai | azure_openai. Changing it needs re-tuning (see eval/README.md).
# On Azure, EAKA_EMBEDDING_MODEL is your embedding DEPLOYMENT name.
# EAKA_EMBEDDER=lsa
# EAKA_EMBEDDING_MODEL=text-embedding-3-small
# EAKA_LEXICAL_WEIGHT=0.5
# EAKA_MIN_RELEVANCE=0.51
# EAKA_TOP_K=6

# ---------------------------------------------------------------- API protection
# Comma-separated keys; empty = open (local use only)
# EAKA_API_KEYS=change-me
# EAKA_RATE_LIMIT_PER_MINUTE=30
