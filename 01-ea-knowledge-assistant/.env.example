# Copy to .env and fill in what you use. Everything is optional: with no keys the assistant runs
# fully offline (hybrid BM25 + LSA retrieval, extractive cited answers).

# --- Answer generation: extractive | anthropic | azure_openai | openai
EAKA_LLM_PROVIDER=extractive
# EAKA_LLM_MODEL=                       # e.g. claude-sonnet-4-5, gpt-4o-mini, or your Azure deployment name
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Embeddings: lsa | openai | azure_openai | sentence_transformers
EAKA_EMBEDDER=lsa
# EAKA_EMBEDDING_MODEL=text-embedding-3-small

# --- Retrieval tuning (defaults were tuned on the eval dev split for the lsa embedder;
#     re-run eval/run_eval.py and update these if you change embedder)
# EAKA_LEXICAL_WEIGHT=0.5
# EAKA_MIN_RELEVANCE=0.51
# EAKA_TOP_K=6

# --- API protection (comma-separated keys; empty = open, for local use only)
# EAKA_API_KEYS=change-me
# EAKA_RATE_LIMIT_PER_MINUTE=30
